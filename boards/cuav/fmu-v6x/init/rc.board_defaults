#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

param set-default SENS_EN_INA238 0
param set-default SENS_EN_INA228 0
param set-default SENS_EN_INA226 1


# Mavlink ethernet (CFG 1000)
param set-default MAV_2_CONFIG 1000
param set-default MAV_2_BROADCAST 1
param set-default MAV_2_MODE 0
param set-default MAV_2_RADIO_CTL 0
param set-default MAV_2_RATE 100000
param set-default MAV_2_REMOTE_PRT 14550
param set-default MAV_2_UDP_PRT 14550

# The companion computer and its Micro XRCE-DDS Agent use ROS domain 99
# over the direct Ethernet link at 192.168.1.10:8888.
# Disable the generic serial/network autostart. rc.board_extras configures
# eth0 first and then starts the client with explicit Ethernet arguments.
param set UXRCE_DDS_CFG 0
param set UXRCE_DDS_DOM_ID 99
param set UXRCE_DDS_AG_IP -1062731510
param set UXRCE_DDS_PRT 8888

param set-default USB_MAV_MODE 5

safety_button start

# CUAV pwm voltage 3.3V/5V switch
pwm_voltage_apply start
