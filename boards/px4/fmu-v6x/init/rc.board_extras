#!/bin/sh
#
# FMU-v6X direct companion-computer Ethernet XRCE-DDS link.
# This runs late in rcS, after parameters, networking and uORB are initialized.
#------------------------------------------------------------------------------

ifconfig eth0 192.168.1.3 netmask 255.255.255.0
uxrce_dds_client start -t udp -h 192.168.1.10 -p 8888
