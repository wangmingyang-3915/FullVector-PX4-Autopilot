<?xml version="1.0"?>
<package format="3">
  <name>vision_dashboard_image_relay</name>
  <version>0.1.0</version>
  <description>Low overhead continuous image monitor for the onboard vision dashboard.</description>
  <maintainer email="jetson@example.com">jetson</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>apriltag_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
